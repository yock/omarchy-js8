#!/bin/sh
# Build only the static dependencies (used by bin/test).
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
DEPS="$ROOT/build/deps"
MODEM="${GFSK8_MODEM_DIR:-$ROOT/../gfsk8-modem}"

if [ ! -d "$MODEM/src" ]; then
    echo "gfsk8-modem not found at $MODEM" >&2
    exit 1
fi

mkdir -p "$DEPS/gfsk8modem/obj"
OBJ="$DEPS/gfsk8modem/obj"
for file in \
    JS8.cpp JS8Submode.cpp FrequencyTracker.cpp Varicode.cpp \
    JSC.cpp JSC_map.cpp JSC_list.cpp DecodedText.cpp api.cpp
do
    g++ -std=c++20 -O2 -fPIC \
        -I"$MODEM/include" -I"$MODEM/src" -I"$MODEM/vendor" -I"$MODEM/vendor/kissfft" \
        -c "$MODEM/src/$file" -o "$OBJ/${file%.cpp}.o"
done
for file in kiss_fft.c kiss_fftr.c; do
    gcc -O2 -fPIC -I"$MODEM/vendor/kissfft" \
        -c "$MODEM/vendor/kissfft/$file" -o "$OBJ/${file%.c}.o"
done
ar rcs "$DEPS/gfsk8modem/libgfsk8modem.a" "$OBJ"/*.o
echo "Built $DEPS/gfsk8modem/libgfsk8modem.a"
